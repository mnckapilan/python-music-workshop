modules = ["python-3.11"]

[nix]
channel = "stable-24_05"

[workflows]
runButton = "Run Current Exercise"

[[workflows.workflow]]
name = "Run Current Exercise"
mode = "sequential"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python exercises/exercise_01_variables_and_strings.py"

[deployment]
run = ["sh", "-c", "python exercises/exercise_01_variables_and_strings.py"]
