#!/bin/bash
# Convenience wrapper — runs the bundled Python runtime.
# Usage from project root:
#   ./python3 exercises/exercise_01_variables_and_strings.py
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ARCH=$(uname -m)
if [ "$ARCH" = "arm64" ] && [ -f "$SCRIPT_DIR/python-runtime/mac-arm64/bin/python3" ]; then
    exec "$SCRIPT_DIR/python-runtime/mac-arm64/bin/python3" "$@"
elif [ -f "$SCRIPT_DIR/python-runtime/mac-x86/bin/python3" ]; then
    exec "$SCRIPT_DIR/python-runtime/mac-x86/bin/python3" "$@"
else
    echo "Python runtime not found. Please run setup/setup.command first." >&2
    exit 1
fi
